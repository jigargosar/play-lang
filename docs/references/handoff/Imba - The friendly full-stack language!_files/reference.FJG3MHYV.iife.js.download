`,aliases:["tdc"]},id:3450}),e[3451]=t({parent:e[2353],name:"list-style-image",flags:4,mods:0,cat:2,meta:{desc:`<p>Sets the image that will be used as the list item marker. When the image is available, it will replace the marker set with the &#39;list-style-type&#39; marker.</p>
`},id:3451}),e[3452]=t({parent:e[3451],name:"none",flags:8,mods:0,cat:32,meta:{desc:`<p>The default contents of the of the list item’s marker are given by &#39;list-style-type&#39; instead.</p>
`,imba:!0},id:3452}),e[3453]=t({parent:e[2353],name:"column-count",flags:4,mods:0,cat:2,meta:{desc:`<p>Describes the optimal number of columns into which the content of the element will be flowed.</p>
