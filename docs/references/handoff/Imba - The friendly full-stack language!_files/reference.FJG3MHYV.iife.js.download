`},id:3445}),e[3446]=t({parent:e[3445],name:"none",flags:8,mods:0,cat:32,meta:{desc:`<p>The counter is not modified.</p>
`,imba:!0},id:3446}),e[3447]=t({parent:e[2353],name:"margin-block-start",flags:4,mods:0,cat:2,meta:{desc:`<p>Logical &#39;margin-top&#39;. Mapping depends on the parent element’s &#39;writing-mode&#39;, &#39;direction&#39;, and &#39;text-orientation&#39;.</p>
`},id:3447}),e[3448]=t({parent:e[2353],name:"counter-increment",flags:4,mods:0,cat:2,meta:{desc:`<p>Manipulate the value of existing counters.</p>
`},id:3448}),e[3449]=t({parent:e[3448],name:"none",flags:8,mods:0,cat:32,meta:{desc:`<p>This element does not alter the value of any counters.</p>
