`,aliases:["olc"]},id:3425}),e[3426]=t({parent:e[3425],name:"invert",flags:8,mods:0,cat:32,meta:{desc:`<p>Performs a color inversion on the pixels on the screen.</p>
`,imba:!0},id:3426}),e[3427]=t({parent:e[2353],name:"margin-block-end",flags:4,mods:0,cat:2,meta:{desc:`<p>Logical &#39;margin-bottom&#39;. Mapping depends on the parent element’s &#39;writing-mode&#39;, &#39;direction&#39;, and &#39;text-orientation&#39;.</p>
`},id:3427}),e[3428]=t({parent:e[2353],name:"animation-play-state",flags:4,mods:0,cat:2,meta:{desc:`<p>Defines whether the animation is running or paused.</p>
